{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "able",
  "main": "src/worker.tsx",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat",
    // @cloudflare/voice 0.3.5 only forwards inbound microphone frames when
    // Agents SDK delivers them as ArrayBuffer. Compatibility dates on or after
    // 2026-03-17 otherwise deliver binary WebSocket messages as Blob, which
    // makes the voice mixin silently discard every audio frame. Remove this
    // bridge once the published voice package handles Blob input.
    "no_websocket_standard_binary_type"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/", "/healthz", "/.well-known/ucp", "/mcp", "/ops", "/ops/*", "/webhooks/whatsapp", "/kb*", "/requests*", "/workspace-theme.css", "/portal/*", "/voice", "/demo/voice", "/agents/*", "/auth/*"]
  },
  "vars": {
    "ABLE_VOICE_DEMO_ENABLED": "1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AbleDeskAgent",
        "class_name": "AbleDeskAgent"
      }
    ]
  },
  // Migration tags are an immutable contract: Cloudflare records which tags a
  // Worker has applied, so an already-applied tag must keep its original
  // contents. v1 therefore still names the class as it was first created, and
  // the rename to Able is expressed as a new tag. A fresh install applies both
  // in sequence and lands on AbleDeskAgent; a Worker that already applied v1
  // applies only v2 and keeps its Durable Object state.
  "migrations": [
    {
      "tag": "v1_voice_demo",
      "new_sqlite_classes": ["AbleDeskVoiceDemoAgent"]
    },
    {
      "tag": "v2_rename_desk_agent",
      "renamed_classes": [{ "from": "AbleDeskVoiceDemoAgent", "to": "AbleDeskAgent" }]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "able",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEDIA_QUEUE",
        "queue": "able-media"
      }
    ],
    "consumers": [
      {
        "queue": "able-media",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
